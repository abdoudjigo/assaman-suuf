
# ==========================================================
# ASSAMAN-SUUF — VARIABLES D'ENVIRONNEMENT
# Copier vers .env puis compléter les valeurs nécessaires.
# Ne jamais mettre de véritables mots de passe ou clés privées
# dans ce fichier modèle.
# ==========================================================


# ==========================================================
# 1. DOCKER / IMAGE API
# ==========================================================

IMAGE_NAME=yourdockerhubuser/dataflow360-api:1.0.0


# ==========================================================
# 2. APACHE AIRFLOW
# ==========================================================

AIRFLOW_IMAGE_NAME=apache/airflow:3.3.2
AIRFLOW_UID=50000

# Générer une véritable clé Fernet avant de démarrer Airflow
FERNET_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# Remplacer par un secret aléatoire
AIRFLOW__API_AUTH__JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=CHANGE_ME

_PIP_ADDITIONAL_REQUIREMENTS=


# ==========================================================
# 3. SNOWFLAKE
# ==========================================================

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_DATABASE=
SNOWFLAKE_SCHEMA=

# Authentification par mot de passe :
# renseigner uniquement si le code utilise cette méthode.
SNOWFLAKE_PASSWORD=

# Chemins locaux de référence ; le Compose API les remplacera
# par les chemins des secrets montés dans le conteneur.
SNOWFLAKE_PRIVATE_KEY_PATH=secrets/snowflake_api_key.pem
SNOWFLAKE_PRIVATE_KEY_PASSWORD_FILE=secrets/snowflake_api_key_password.txt

# Valeurs locales ; Docker Compose les remplacera
REDIS_HOST=localhost
REDIS_PORT=6379
# ==========================================================
# 4. BASES DE DONNÉES
# ==========================================================

# À adapter au service et au contexte d'exécution.
POSTGRES_URL=

# Exemple de format, sans vrai mot de passe :
# mongodb://admin:CHANGE_ME@mongodb:27017/?authSource=admin
MONGODB_URI=


# ==========================================================
# 5. KAFKA
# ==========================================================

# Pour un client exécuté dans un conteneur Docker :
KAFKA_BOOTSTRAP_SERVERS=kafka:9094

# Pour un script Python exécuté directement sur la machine :
KAFKA_BOOTSTRAP_SERVERS_HOST=localhost:9092


# ==========================================================
# 6. FRONTEND
# ==========================================================

# URL de l'API accessible depuis le navigateur de l'utilisateur.
VITE_API_URL=http://localhost:8001