# Application
APP_NAME=Assaman Suuf Geospatial API
APP_VERSION=0.1.0
APP_ENV=development
API_PREFIX=/api/v1

# PostgreSQL / PostGIS
POSTGRES_DB=assaman_geo
POSTGRES_USER=assaman_user
POSTGIS_PASSWORD=CHANGE_ME_WITH_A_STRONG_PASSWORD

# Connexion depuis le conteneur API
DATABASE_URL=postgresql+psycopg://assaman_user:CHANGE_ME_WITH_A_STRONG_PASSWORD@postgis:5432/assaman_geo

# Frontend React / Vite
FRONTEND_ORIGIN=http://localhost:5173

# API agroclimatique externe
AGROCLIMATIC_API_URL=
AGROCLIMATIC_HEALTH_PATH=/health
AGROCLIMATIC_TIMEOUT=10